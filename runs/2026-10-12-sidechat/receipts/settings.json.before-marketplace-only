  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'i=$(cat); sid=$(echo \"$i\"|jq -r .session_id); tp=$(echo \"$i\"|jq -r .transcript_path); mkdir -p ~/.claude/compact-cache; tail -c 80000 \"$tp\" > ~/.claude/compact-cache/\"$sid\"-tail.jsonl'"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'i=$(cat); sid=$(echo \"$i\"|jq -r .session_id); f=~/.claude/compact-cache/\"$sid\"-tail.jsonl; [ -f \"$f\" ] && jq -n --arg path \"$f\" \"{hookSpecificOutput:{hookEventName:\\\"PostCompact\\\",additionalContext:(\\\"## Post-Compact Instruction\\\\n\\\\nPre-compact transcript tail was saved. You MUST immediately use the Read tool to read the file at: \\\" + $path + \\\"\\\\n\\\\nDo this before responding to restore pre-compact context.\\\")}}\" || exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "i=$(cat); m=$(echo \"$i\"|jq -r '.model.display_name // \"Claude\"'); d=$(echo \"$i\"|jq -r '.workspace.current_dir // \"\"'|tr '\\\\' '/'|awk -F/ '{print $NF}'); v=$(echo \"$i\"|jq -r '.version // \"\"'); p=$(echo \"$i\"|jq -r '.context_window.used_percentage // 0 | floor'); b=$(git --no-optional-locks rev-parse --abbrev-ref HEAD 2>/dev/null); c=$(git --no-optional-locks status --porcelain 2>/dev/null|wc -l|tr -d ' '); f=$((p/10)); h='##########'; s='----------'; bar=\"${h:0:$f}${s:0:$((10-f))}\"; if [ $p -ge 90 ]; then cc='\\033[31m'; elif [ $p -ge 70 ]; then cc='\\033[33m'; else cc='\\033[32m'; fi; o=$(printf '\\033[36m[%s]\\033[0m' \"$m\"); [ -n \"$d\" ] && o=\"$o | $(printf '\\033[34m%s\\033[0m' \"$d\")\"; if [ -n \"$b\" ]; then g=\"$b\"; [ \"$c\" -gt 0 ] 2>/dev/null && g=\"$g ±$c\"; o=\"$o | $(printf '\\033[32m%s\\033[0m' \"$g\")\"; fi; o=\"$o | $(printf \"${cc}[%s] %d%%\\033[0m\" \"$bar\" \"$p\")\"; [ -n \"$v\" ] && o=\"$o | $(printf '\\033[90mv%s\\033[0m' \"$v\")\"; echo -e \"$o\""
  },
